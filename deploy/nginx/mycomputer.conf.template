map $uri $commerce_cache_control {
    default "";
    /cart "no-store, private";
    /checkout "no-store, private";
    /checkout/success "no-store, private";
}

server {
    listen 80;
    server_name _;
    root /var/www/html/public;
    index index.php;

    client_max_body_size 20m;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Cache-Control $commerce_cache_control always;

    set $public_commerce_enabled "${PUBLIC_COMMERCE_ENABLED}";
    set $public_commerce_confirmation_enabled "${PUBLIC_COMMERCE_CONFIRMATION_ENABLED}";
    set $legal_content_approved "${LEGAL_CONTENT_APPROVED}";

    location @frontend {
        proxy_pass http://frontend:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    location = / {
        try_files $uri @frontend;
    }

    location = /en {
        try_files $uri @frontend;
    }

    location = /en/ {
        absolute_redirect off;
        return 308 /en$is_args$args;
    }

    location = /catalog {
        try_files $uri @frontend;
    }

    location = /catalog/ {
        try_files $uri @frontend;
    }

    location = /en/catalog {
        try_files $uri @frontend;
    }

    location = /en/catalog/ {
        try_files $uri @frontend;
    }

    location = /categories {
        try_files $uri @frontend;
    }

    location = /categories/ {
        try_files $uri @frontend;
    }

    location = /en/categories {
        try_files $uri @frontend;
    }

    location = /en/categories/ {
        try_files $uri @frontend;
    }

    location ^~ /c/ {
        try_files $uri @frontend;
    }

    location ^~ /p/ {
        try_files $uri @frontend;
    }

    location ^~ /en/c/ {
        try_files $uri @frontend;
    }

    location ^~ /en/p/ {
        try_files $uri @frontend;
    }

    location ^~ /_nuxt/ {
        try_files $uri @frontend;
        access_log off;
        expires 30d;
    }

    location ^~ /_ipx/ {
        try_files $uri @frontend;
        access_log off;
        expires 30d;
    }

    location = /obshti-usloviya {
        try_files $uri @frontend;
    }

    location = /obshti-usloviya/ {
        absolute_redirect off;
        return 308 /obshti-usloviya$is_args$args;
    }

    location = /politika-za-poveritelnost {
        try_files $uri @frontend;
    }

    location = /politika-za-poveritelnost/ {
        absolute_redirect off;
        return 308 /politika-za-poveritelnost$is_args$args;
    }

    location = /cart {
        if ($public_commerce_enabled != "true") { return 404; }
        if ($public_commerce_confirmation_enabled != "true") { return 404; }
        if ($legal_content_approved != "true") { return 404; }
        try_files $uri @frontend;
    }

    location = /cart/ {
        if ($public_commerce_enabled != "true") { return 404; }
        if ($public_commerce_confirmation_enabled != "true") { return 404; }
        if ($legal_content_approved != "true") { return 404; }
        absolute_redirect off;
        return 308 /cart$is_args$args;
    }

    location = /checkout {
        if ($public_commerce_enabled != "true") { return 404; }
        if ($public_commerce_confirmation_enabled != "true") { return 404; }
        if ($legal_content_approved != "true") { return 404; }
        try_files $uri @frontend;
    }

    location = /checkout/ {
        if ($public_commerce_enabled != "true") { return 404; }
        if ($public_commerce_confirmation_enabled != "true") { return 404; }
        if ($legal_content_approved != "true") { return 404; }
        absolute_redirect off;
        return 308 /checkout$is_args$args;
    }

    location = /checkout/success {
        if ($public_commerce_confirmation_enabled != "true") { return 404; }
        if ($public_commerce_enabled !~ "^(true|false)$") { return 404; }
        try_files $uri @frontend;
    }

    location = /checkout/success/ {
        if ($public_commerce_confirmation_enabled != "true") { return 404; }
        if ($public_commerce_enabled !~ "^(true|false)$") { return 404; }
        absolute_redirect off;
        return 308 /checkout/success$is_args$args;
    }

    location ^~ /cart/ { return 404; }
    location ^~ /checkout/ { return 404; }
    location = /en/cart { return 404; }
    location ^~ /en/cart/ { return 404; }
    location = /en/checkout { return 404; }
    location ^~ /en/checkout/ { return 404; }
    location = /en/terms { return 404; }
    location ^~ /en/terms/ { return 404; }
    location = /en/privacy { return 404; }
    location ^~ /en/privacy/ { return 404; }
    location = /en/obshti-usloviya { return 404; }
    location ^~ /en/obshti-usloviya/ { return 404; }
    location = /en/politika-za-poveritelnost { return 404; }
    location ^~ /en/politika-za-poveritelnost/ { return 404; }
    location = /account { return 404; }
    location ^~ /account/ { return 404; }
    location = /login { return 404; }
    location = /register { return 404; }
    location = /forgot-password { return 404; }
    location = /reset-password { return 404; }
    location = /wishlist { return 404; }
    location ^~ /wishlist/ { return 404; }
    location = /compare { return 404; }
    location ^~ /compare/ { return 404; }

    location ^~ /admin {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ^~ /api/ {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ^~ /livewire/ {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ^~ /vendor/ {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ^~ /build/ {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location /storage/ {
        alias /var/www/html/storage/app/public/;
        try_files $uri =404;
        access_log off;
        expires 30d;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        fastcgi_pass app:9000;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_read_timeout 120s;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }

    location ~* \.(?:env|log|sql|sqlite|bak)$ {
        deny all;
    }
}
