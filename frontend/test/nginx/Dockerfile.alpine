ARG NGINX_IMAGE=nginx:1.27-alpine
FROM ${NGINX_IMAGE}

# CI-only harness, not the frontend application image or a production service.
RUN apk add --no-cache nodejs npm
WORKDIR /fixture/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY frontend/test/nginx ./test/nginx
COPY deploy/nginx/mycomputer.conf.template /fixture/deploy/nginx/mycomputer.conf.template
RUN mkdir /evidence && chown nginx:nginx /evidence

ENV NGINX_BINARY=/usr/sbin/nginx
ENV NGINX_FASTCGI_PARAMS=/etc/nginx/fastcgi_params
ENV NGINX_TEST_OUTPUT=/evidence/proxy
ENV REQUIRE_ALPINE=1
USER nginx
ENTRYPOINT ["node"]
CMD ["test/nginx/card-cache.mjs"]
